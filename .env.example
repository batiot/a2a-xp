# Required for all agents — Google AI Studio key
# Get one free at https://aistudio.google.com/apikey
GOOGLE_STUDIO_API_KEY=

# Optional - only needed for LangGraph Agent Server cloud features
# Leave blank for self-hosted non-commercial use
LANGSMITH_API_KEY=

# LangGraph infra (used by langgraph agent + infra services)
POSTGRES_DB=langgraph
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=langgraph_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
